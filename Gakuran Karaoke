import sys
import requests
import keyboard  # Biblioteca para hotkeys globais no Windows
from PyQt6.QtCore import Qt, QTimer, QPoint, pyqtSignal, QObject
from PyQt6.QtGui import QColor
from PyQt6.QtWidgets import (
    QApplication, QLabel, QVBoxLayout, QHBoxLayout, 
    QWidget, QLineEdit, QPushButton, QListWidget, QListWidgetItem,
    QTabWidget, QFormLayout, QComboBox, QSpinBox, QSlider, QColorDialog,
    QGroupBox, QMessageBox
)

class GlobalSignals(QObject):
    trigger_play = pyqtSignal()
    trigger_stop = pyqtSignal()
    trigger_forward = pyqtSignal()
    trigger_backward = pyqtSignal()

class KaraokeController(QWidget):
    def __init__(self, overlay, signals):
        super().__init__()
        self.overlay = overlay
        self.signals = signals
        
        self.hotkeys = {
            "play": "space",
            "stop": "r",
            "forward": "right",
            "backward": "left"
        }
        
        self.initUI()
        self.register_hotkeys()
        
    def initUI(self):
        self.setWindowTitle("Gakuran Karaoke - Painel de Controle & Keybinds Globais")
        self.resize(520, 520)
        
        main_layout = QVBoxLayout()
        self.tabs = QTabWidget()
        
        # TAB 1: Pesquisa & Controles
        self.tab_search = QWidget()
        search_layout = QVBoxLayout()
        
        input_layout = QHBoxLayout()
        self.input_query = QLineEdit()
        self.input_query.setPlaceholderText("Ex: Shape of You - Ed Sheeran")
        self.input_query.returnPressed.connect(self.search_song)
        
        btn_search = QPushButton("Pesquisar")
        btn_search.clicked.connect(self.search_song)
        
        input_layout.addWidget(self.input_query)
        input_layout.addWidget(btn_search)
        search_layout.addLayout(input_layout)
        
        self.list_results = QListWidget()
        self.list_results.itemDoubleClicked.connect(self.select_song)
        search_layout.addWidget(self.list_results)
        
        controls_layout = QHBoxLayout()
        self.btn_play = QPushButton("▶ Play / Pausa")
        self.btn_play.clicked.connect(self.overlay.toggle_play)
        
        self.btn_stop = QPushButton("⏹ Parar / Reset")
        self.btn_stop.clicked.connect(self.overlay.stop_playback)
        
        controls_layout.addWidget(self.btn_play)
        controls_layout.addWidget(self.btn_stop)
        search_layout.addLayout(controls_layout)
        
        self.tab_search.setLayout(search_layout)
        self.tabs.addTab(self.tab_search, "🎵 Músicas")
        
        # TAB 2: Configurações Visuais & Keybinds Globais
        self.tab_settings = QWidget()
        settings_layout = QVBoxLayout()
        form = QFormLayout()
        
        self.btn_text_color = QPushButton("Escolher Cor do Texto")
        self.btn_text_color.clicked.connect(self.choose_text_color)
        form.addRow("Cor do Texto:", self.btn_text_color)
        
        self.btn_bg_color = QPushButton("Escolher Cor de Fundo")
        self.btn_bg_color.clicked.connect(self.choose_bg_color)
        form.addRow("Cor de Fundo:", self.btn_bg_color)
        
        self.slider_opacity = QSlider(Qt.Orientation.Horizontal)
        self.slider_opacity.setRange(0, 255)
        self.slider_opacity.setValue(180)
        self.slider_opacity.valueChanged.connect(self.update_style)
        form.addRow("Opacidade do Fundo:", self.slider_opacity)
        
        self.spin_font_size = QSpinBox()
        self.spin_font_size.setRange(12, 48)
        self.spin_font_size.setValue(22)
        self.spin_font_size.valueChanged.connect(self.update_style)
        form.addRow("Tamanho da Fonte:", self.spin_font_size)
        
        self.combo_font = QComboBox()
        self.combo_font.addItems(["Arial", "Trebuchet MS", "Segoe UI", "Verdana", "Impact", "Courier New"])
        self.combo_font.currentTextChanged.connect(self.update_style)
        form.addRow("Tipo de Fonte:", self.combo_font)
        
        settings_layout.addLayout(form)
        
        kb_group = QGroupBox("⌨️ Keybinds Globais (Funcionam com o Roblox em foco)")
        kb_form = QFormLayout()
        
        self.btn_kb_play = QPushButton(self.hotkeys["play"].upper())
        self.btn_kb_play.clicked.connect(lambda: self.start_capture("play", self.btn_kb_play))
        kb_form.addRow("Play / Pausa:", self.btn_kb_play)
        
        self.btn_kb_stop = QPushButton(self.hotkeys["stop"].upper())
        self.btn_kb_stop.clicked.connect(lambda: self.start_capture("stop", self.btn_kb_stop))
        kb_form.addRow("Parar / Reset:", self.btn_kb_stop)
        
        self.btn_kb_forward = QPushButton(self.hotkeys["forward"].upper())
        self.btn_kb_forward.clicked.connect(lambda: self.start_capture("forward", self.btn_kb_forward))
        kb_form.addRow("Avançar 3s:", self.btn_kb_forward)
        
        self.btn_kb_backward = QPushButton(self.hotkeys["backward"].upper())
        self.btn_kb_backward.clicked.connect(lambda: self.start_capture("backward", self.btn_kb_backward))
        kb_form.addRow("Recuar 3s:", self.btn_kb_backward)
        
        kb_group.setLayout(kb_form)
        settings_layout.addWidget(kb_group)
        
        self.tab_settings.setLayout(settings_layout)
        self.tabs.addTab(self.tab_settings, "⚙️ Aparência & Keybinds")
        
        main_layout.addWidget(self.tabs)
        self.setLayout(main_layout)
        
        self.current_text_color = QColor("#00FFFF")
        self.current_bg_color = QColor(0, 0, 0)

    def start_capture(self, action_key, button_widget):
        button_widget.setText("Pressione uma tecla...")
        QMessageBox.information(self, "Capturar Atalho", "Pressione a tecla desejada no teclado e clique em OK.")
        try:
            event = keyboard.read_event(suppress=False)
            if event.event_type == keyboard.KEY_DOWN:
                new_key = event.name
                self.hotkeys[action_key] = new_key
                button_widget.setText(new_key.upper())
                self.register_hotkeys()
        except Exception:
            button_widget.setText(self.hotkeys[action_key].upper())

    def register_hotkeys(self):
        try:
            keyboard.unhook_all()
        except:
            pass
            
        try:
            keyboard.add_hotkey(self.hotkeys["play"], lambda: self.signals.trigger_play.emit())
            keyboard.add_hotkey(self.hotkeys["stop"], lambda: self.signals.trigger_stop.emit())
            keyboard.add_hotkey(self.hotkeys["forward"], lambda: self.signals.trigger_forward.emit())
            keyboard.add_hotkey(self.hotkeys["backward"], lambda: self.signals.trigger_backward.emit())
        except Exception as e:
            print(f"Erro ao registrar hotkeys: {e}")

    def choose_text_color(self):
        color = QColorDialog.getColor(self.current_text_color, self, "Escolher Cor do Texto")
        if color.isValid():
            self.current_text_color = color
            self.update_style()

    def choose_bg_color(self):
        color = QColorDialog.getColor(self.current_bg_color, self, "Escolher Cor de Fundo")
        if color.isValid():
            self.current_bg_color = color
            self.update_style()

    def update_style(self):
        text_hex = self.current_text_color.name()
        r, g, b = self.current_bg_color.red(), self.current_bg_color.green(), self.current_bg_color.blue()
        alpha = self.slider_opacity.value()
        font_size = self.spin_font_size.value()
        font_family = self.combo_font.currentText()
        
        style = f"""
            color: {text_hex}; 
            font-size: {font_size}px; 
            font-weight: bold; 
            font-family: '{font_family}', sans-serif;
            background-color: rgba({r}, {g}, {b}, {alpha});
            padding: 12px;
            border-radius: 10px;
        """
        self.overlay.apply_style(style)

    def search_song(self):
        query = self.input_query.text().strip()
        if not query:
            return
            
        self.list_results.clear()
        try:
            url = f"https://lrclib.net/api/search?q={query}"
            response = requests.get(url, timeout=5)
            if response.status_code == 200:
                results = response.json()
                for item in results:
                    if item.get("syncedLyrics"):
                        track_name = item.get("trackName", "Desconhecido")
                        artist_name = item.get("artistName", "Desconhecido")
                        display_text = f"{track_name} - {artist_name}"
                        
                        list_item = QListWidgetItem(display_text)
                        list_item.setData(Qt.ItemDataRole.UserRole, item["syncedLyrics"])
                        self.list_results.addItem(list_item)
        except Exception as e:
            self.list_results.addItem(f"Erro na conexão: {str(e)}")
            
    def select_song(self, item):
        synced_lyrics = item.data(Qt.ItemDataRole.UserRole)
        self.overlay.load_lyrics(synced_lyrics)

class KaraokeOverlay(QWidget):
    def __init__(self, signals):
        super().__init__()
        self.lyrics_data = []
        self.current_index = 0
        self.elapsed_seconds = -3.0  # Começa em -3.0 para dar os 3 segundos de intro do Gakuran!
        self.is_playing = False
        
        signals.trigger_play.connect(self.toggle_play)
        signals.trigger_stop.connect(self.stop_playback)
        signals.trigger_forward.connect(self.skip_forward)
        signals.trigger_backward.connect(self.skip_backward)
        
        self.initUI()
        
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_timer)
        self.old_pos = QPoint()

    def initUI(self):
        self.setWindowFlags(
            Qt.WindowType.FramelessWindowHint | 
            Qt.WindowType.WindowStaysOnTopHint | 
            Qt.WindowType.Tool
        )
        self.setAttribute(Qt.WidgetAttribute.WA_TranslucentBackground, True)
        self.setGeometry(150, 150, 600, 110)
        
        layout = QVBoxLayout()
        
        self.label = QLabel("Pesquise e selecione uma música no painel!", self)
        self.default_style = """
            color: #00FFFF; 
            font-size: 22px; 
            font-weight: bold; 
            font-family: Arial, sans-serif;
            background-color: rgba(0, 0, 0, 180);
            padding: 12px;
            border-radius: 10px;
        """
        self.label.setStyleSheet(self.default_style)
        self.label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.label.setWordWrap(True)
        layout.addWidget(self.label)
        
        self.setLayout(layout)

    def apply_style(self, style_str):
        self.label.setStyleSheet(style_str)

    def load_lyrics(self, lrc_text):
        self.lyrics_data = []
        self.stop_playback()
        
        lines = lrc_text.replace('\\n', '\n').split('\n')
        
        for line in lines:
            if ']' in line:
                try:
                    time_part, text_part = line.split(']', 1)
                    time_part = time_part.replace('[', '').strip()
                    
                    if ':' in time_part:
                        parts = time_part.split(':')
                        minutes = float(parts[0])
                        seconds = float(parts[1])
                        total_sec = (minutes * 60) + seconds
                        
                        text_clean = text_part.strip()
                        if text_clean:
                            self.lyrics_data.append((total_sec, text_clean))
                except Exception:
                    continue
                    
        if self.lyrics_data:
            self.lyrics_data.sort(key=lambda x: x[0])
            self.label.setText("Música carregada! Pressione Play (Intro de 3s...).")
        else:
            self.label.setText("Erro ao ler os tempos da letra.")

    def toggle_play(self):
        if not self.lyrics_data:
            self.label.setText("Carregue uma música primeiro!")
            return
            
        if self.is_playing:
            self.timer.stop()
            self.is_playing = False
        else:
            self.elapsed_seconds = -3.0  # Reseta contando os 3 segundos iniciais
            self.current_index = 0
            self.timer.start(200)
            self.is_playing = True

    def stop_playback(self):
        self.timer.stop()
        self.is_playing = False
        self.elapsed_seconds = -3.0
        self.current_index = 0
        if self.lyrics_data:
            self.label.setText("Parado / Pronto para recomeçar")
        else:
            self.label.setText("Nenhuma música carregada.")

    def skip_forward(self):
        self.elapsed_seconds += 3.0

    def skip_backward(self):
        self.elapsed_seconds = max(-3.0, self.elapsed_seconds - 3.0)
        self.current_index = 0
        while (self.current_index < len(self.lyrics_data) and 
               self.elapsed_seconds >= self.lyrics_data[self.current_index][0]):
            self.current_index += 1

    def update_timer(self):
        self.elapsed_seconds += 0.2
        
        # Durante os 3 primeiros segundos (intro do Gakuran), mostra contagem ou limpa a tela
        if self.elapsed_seconds < 0:
            segundos_restantes = abs(round(self.elapsed_seconds))
            self.label.setText(f"Preparando instrumentos... ({segundos_restantes}s)")
            return
            
        # Verifica se há letra para o momento atual
        # Se o tempo passou da última linha ou ainda não chegou na primeira, fica sem texto
        active_text = ""
        
        # Procura qual deve ser a frase exibida com base no tempo atual
        # Lógica para mostrar apenas quando o timestamp corresponde
        if self.lyrics_data:
            # Encontra a linha atual ativa
            current_line = ""
            for t, text in self.lyrics_data:
                if self.elapsed_seconds >= t:
                    current_line = text
                else:
                    break
            
            # Se a linha atual estiver muito distante da próxima e houver um espaço longo sem cantar, limpa o texto
            if current_line:
                # Verifica se a próxima linha ainda demorará muito para dar espaço de silêncio, se desejado,
                # mas por padrão mantém a frase até a próxima chegar. Se quiser sumir quando acabar, podemos ajustar.
                self.label.setText(current_line)
            else:
                self.label.setText("") # Fica sem texto se não houver letra neste segundo

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.old_pos = event.globalPosition().toPoint()

    def mouseMoveEvent(self, event):
        if event.buttons() == Qt.MouseButton.LeftButton:
            delta = event.globalPosition().toPoint() - self.old_pos
            self.move(self.pos() + delta)
            self.old_pos = event.globalPosition().toPoint()

if __name__ == '__main__':
    app = QApplication(sys.argv)
    
    signals = GlobalSignals()
    
    overlay = KaraokeOverlay(signals)
    overlay.show()
    
    controller = KaraokeController(overlay, signals)
    controller.show()
    
    sys.exit(app.exec())